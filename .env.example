# ─────────────────────────────────────────────────────────────────────────────
# PRUMO — environment variables
# Copy to .env.local and fill in. Never commit real secrets.
# Every integration is optional at boot: a missing variable disables only the
# feature that depends on it, and the UI says exactly what is missing.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL (used in invite links, auth redirects and the WhatsApp webhook docs).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Data mode:
#   (unset) → Supabase when configured; in-memory demo in development; error page in production
#   on      → force the in-memory demo (fictitious data, shows a banner)
#   off     → require Supabase
PRUMO_DEMO_MODE=

# "true" enables developer tools (WhatsApp simulator) outside development. Keep unset in production.
PRUMO_DEV_TOOLS=

# debug | info | warn | error
LOG_LEVEL=

# ── Supabase ─────────────────────────────────────────────────────────────────
# Project Settings → API. The publishable key is safe for the browser (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS — used exclusively by the WhatsApp webhook and cron jobs.
# NEVER prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# ── OpenAI (interpretation of text, audio and receipts) ──────────────────────
# Without a key the rule-based interpreter handles simple text; audio/images are disabled.
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5-mini
OPENAI_VISION_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_MS=20000

# ── WhatsApp Cloud API (Meta) ────────────────────────────────────────────────
# Webhook URL to register in Meta:  ${NEXT_PUBLIC_APP_URL}/api/whatsapp/webhook
# Any random string; paste the same value in Meta → WhatsApp → Configuration → Verify token.
WHATSAPP_VERIFY_TOKEN=
# Meta App → Settings → Basic → App secret (validates X-Hub-Signature-256).
WHATSAPP_APP_SECRET=
# System user permanent access token with whatsapp_business_messaging permission.
WHATSAPP_ACCESS_TOKEN=
# WhatsApp → API Setup → Phone number ID.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_GRAPH_API_VERSION=v23.0
# Number shown to users in the app ("envie para ..."), e.g. +55 11 90000-0000.
NEXT_PUBLIC_WHATSAPP_DISPLAY_NUMBER=

# ── Jobs ─────────────────────────────────────────────────────────────────────
# Bearer secret for /api/cron/* (recurrences, data retention). Vercel Cron sends it automatically.
CRON_SECRET=

# ── Tests ────────────────────────────────────────────────────────────────────
# PostgreSQL used by `npm run test:db` (see scripts/db-local.sh).
# PRUMO_TEST_DATABASE_URL=postgres://postgres@127.0.0.1:54329/postgres
